<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\model\churn_model.onnx" Link="model\churn_model.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\model\schema.json" Link="model\schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
